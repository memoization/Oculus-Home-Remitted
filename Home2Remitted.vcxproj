  <!-- Resolve APP_VERSION from "git describe" into src\version.gen.h before every compile. The always flag falls back to a short commit if there are no tags. -->
  <Target Name="GenerateVersionHeader" BeforeTargets="ClCompile">
    <Exec Command="git describe --always --tags --abbrev=0"
          WorkingDirectory="$(ProjectDir)"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitVersion" />
    </Exec>
    <PropertyGroup>
      <GitVersion>$(GitVersion.Trim())</GitVersion>
      <GitVersion Condition="'$(GitVersion)' == ''">0.0.0-dev</GitVersion>
    </PropertyGroup>
    <ItemGroup>
      <_VersionHeaderLines Include="#pragma once" />
      <_VersionHeaderLines Include="#define APP_VERSION &quot;$(GitVersion)&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(ProjectDir)src\version.gen.h"
                      Lines="@(_VersionHeaderLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- Stage runtime dependencies beside the built exe: the cpr runtime DLLs (config-specific folder and names) plus the store, images and fonts asset folders. Post-build action into $(OutDir). -->
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <RuntimeDll Condition="'$(Configuration)' == 'Release'" Include="$(ProjectDir)dependencies\cpr\bin\cpr.dll" />
      <RuntimeDll Condition="'$(Configuration)' == 'Release'" Include="$(ProjectDir)dependencies\cpr\bin\libcurl.dll" />
      <RuntimeDll Condition="'$(Configuration)' == 'Release'" Include="$(ProjectDir)dependencies\cpr\bin\zlib1.dll" />
      <RuntimeDll Condition="'$(Configuration)' == 'Debug'" Include="$(ProjectDir)dependencies\cpr\debug\bin\cpr.dll" />
      <RuntimeDll Condition="'$(Configuration)' == 'Debug'" Include="$(ProjectDir)dependencies\cpr\debug\bin\libcurl-d.dll" />
      <RuntimeDll Condition="'$(Configuration)' == 'Debug'" Include="$(ProjectDir)dependencies\cpr\debug\bin\zlibd1.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <StoreFiles Include="$(ProjectDir)store\**\*" />
      <ImageFiles Include="$(ProjectDir)images\**\*" />
      <FontFiles Include="$(ProjectDir)fonts\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(StoreFiles)" DestinationFiles="@(StoreFiles->'$(OutDir)store\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ImageFiles)" DestinationFiles="@(ImageFiles->'$(OutDir)images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FontFiles)" DestinationFiles="@(FontFiles->'$(OutDir)fonts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
